{
  "name": "mycbt",
  "version": "0.1.1",
  "description": "cbt training application",
  "private": true,
  "proxy": "http://localhost:5000",
  "allowedHosts": "all",
  "main": "electron-main.js",
  "homepage": "./",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.2",
    "@fortawesome/free-regular-svg-icons": "^6.5.2",
    "@fortawesome/free-solid-svg-icons": "^6.5.2",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@tanstack/react-query": "^5.90.12",
    "axios": "^1.6.8",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.5.0",
    "body-parser": "^1.20.2",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "font-awesome": "^4.7.0",
    "jquery": "^3.7.1",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.556.0",
    "node-machine-id": "^1.1.12",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.2",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "react-scripts": "5.0.1",
    "recharts": "^3.7.0",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "electron-build": "electron-builder",
    "prod": "cross-env NODE_ENV=production electron .",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "pack": "electron-builder --dir",
    "dist": "npm run build && npm run rebuild && electron-builder",
    "dist-win": "npm run build && npm run rebuild && electron-builder --win",
    "dist-portable": "npm run build && npm run rebuild && electron-builder --win --ia32",
    "dist-both": "npm run build && npm run rebuild && electron-builder --win nsis portable"
  },
  "build": {
    "productName": "Mycbt",
    "appId": "com.muktada.electron.muktada",
    "files": [
      "build/**/*",
      "electron-main.js",
      "node_modules/**/*",
      "!node_modules/**/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/*.d.ts",
      "!node_modules/.bin"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "build/**/*"
    ],
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "ia32"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Mycbt-Portable1.exe"
    }
  },
  "keywords": [],
  "license": "ISC",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "electron": "^29.2.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "web-vitals": "^3.5.2",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "author": {
    "name": "muktada labs",
    "email": "muhammedmuktar@gmail.com"
  }
}
